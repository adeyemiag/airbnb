    "@aws-sdk/client-s3": "^3.996.0",
    "@aws-sdk/lib-storage": "^3.996.0",
    "@prisma/client": "^5.22.0",
    "@terraformer/wkt": "^2.2.1",
    "axios": "^1.13.5",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "prisma": "^5.22.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
